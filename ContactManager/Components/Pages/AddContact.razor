@page "/contacts/add"
@rendermode InteractiveServer
@inject IContactClientService ContactService
@inject IAuthClientService AuthService
@inject NavigationManager Nav

<PageTitle>Add Contact — Contact Manager</PageTitle>

<div class="form-page">
    <div class="form-page-header">
        <a href="/" class="btn btn-outline-secondary btn-sm">
            &larr; Back
        </a>
        <h2 class="form-page-title">Add New Contact</h2>
    </div>

    <div class="form-card">
        <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="AddContactForm">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="mb-3">
                <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
                <InputText id="name" @bind-Value="model.Name" class="form-control" placeholder="John Doe" />
                <ValidationMessage For="() => model.Name" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label for="phone" class="form-label">Phone Number</label>
                <InputText id="phone" @bind-Value="model.Phone" class="form-control"
                           type="tel" placeholder="+1 555 000 0000" />
                <ValidationMessage For="() => model.Phone" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <InputText id="email" @bind-Value="model.Email" class="form-control"
                           type="email" placeholder="john@example.com" />
                <ValidationMessage For="() => model.Email" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label for="notes" class="form-label">Notes</label>
                <InputTextArea id="notes" @bind-Value="model.Notes" class="form-control"
                               rows="3" placeholder="Any additional notes..." />
                <ValidationMessage For="() => model.Notes" class="text-danger small" />
            </div>

            <div class="form-actions">
                <a href="/" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Save Contact
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateContactRequest model = new();
    private string? errorMessage;
    private bool isLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await AuthService.IsAuthenticatedAsync())
            Nav.NavigateTo("/login");
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ContactService.CreateAsync(model);
            if (result is not null)
                Nav.NavigateTo("/");
            else
                errorMessage = "Failed to save contact. Please try again.";
        }
        catch
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
